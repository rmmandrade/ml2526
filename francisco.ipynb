    "    le = LabelEncoder()\n",
    "    X_encoded = le.fit_transform(X.astype(str)).reshape(-1, 1)\n",
    "\n",
    "    mi = mutual_info_classif(X_encoded, y, discrete_features=True, random_state=0)\n",
    "    print(f\"{var}: {mi[0]:.4f}\")\n",
    "\n",
    "for var in X_train_cat:\n",
    "    mutual_info(X_train_cat[var],y_train, var)"
