    "def limpar_anos(df):\n",
    "    df = df.copy()\n",
    "\n",
    "    df[\"year\"] = np.round(df[\"year\"]).astype(\"float\")\n",
    "    df.loc[(df[\"year\"] < 1980) | (df[\"year\"] > 2025),\"year\"] = np.nan\n",
    "    df[\"year\"] = df[\"year\"].astype(\"Int64\")\n",
    "    return df"
   ]
  },
