    "def fill_nans(Xtrain, Xval, cats, ints, floats):\n",
    "    Xtrain = Xtrain.copy()\n",
    "    Xval = Xval.copy()\n",
    "\n",
    "\n",
    "    for column in cats:\n",
    "        Xtrain[column] = Xtrain[column].fillna('UNKNOWN')\n",
    "        Xval[column] = Xval[column].fillna('UNKNOWN')\n",
    "\n",
    "    for column in floats:\n",
    "        mean_to_fill = Xtrain[column].mean()\n",
    "        Xtrain[column] = Xtrain[column].fillna(mean_to_fill)\n",
    "        Xval[column] = Xval[column].fillna(mean_to_fill)\n",
    "    \n",
    "    for column in ints:\n",
    "        median_to_fill = Xtrain[column].median()\n",
    "        Xtrain[column] = Xtrain[column].fillna(median_to_fill).astype(\"Int64\")\n",
    "        Xval[column] = Xval[column].fillna(median_to_fill).astype(\"Int64\")\n",
    "    \n",
    "    return Xtrain, Xval"
   ]
  },
