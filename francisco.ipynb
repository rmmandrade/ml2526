   "source": [
    "def impossible_to_nan(df, col, val=0, lower_upper=\"lower\"):\n",
    "    df=df.copy()\n",
    "\n",
    "    if lower_upper==\"lower\":\n",
    "        df.loc[df[col]<val, col] = np.nan\n",
    "        return df\n",
    "    else:\n",
    "        df.loc[df[col]>val, col] = np.nan\n",
    "        return df"
   ]
  },
