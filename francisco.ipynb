    "\"\"\"RandomizedSearchCV: devia avaliar rmse tambem (por adicionar)\"\"\"\n",
    "\n",
    "# --- Define parameter space (wider than you'd try in GridSearch) ---\n",
    "param_dist = {\n",
    "    \"n_estimators\": [50, 75, 100, 200, 300, 400, 500, 600],\n",
    "    \"max_depth\": [5,7, 10, 15, 20, 25, 30],\n",
    "    \"min_samples_split\": [2, 4, 5, 10, 12, 15],\n",
    "    \"min_samples_leaf\": [1, 2, 5, 7, 10],\n",
    "    \"max_features\": [\"sqrt\", \"log2\", 0.8, 0.5, 0.7],\n",
    "    \"max_samples\": [0.7, 0.8, 0.9]\n",
    "}\n",
    "\n",
    "# --- How many random parameter combinations to try ---\n",
    "n_iter = 30\n",
    "param_samples = [\n",
    "    {key: random.choice(values) for key, values in param_dist.items()}\n",
    "    for _ in range(n_iter)\n",
    "]\n",
    "\n",
    "# --- 5-fold cross-validator ---\n",
    "kf_search = KFold(n_splits=5, shuffle=True, random_state=RANDOM_SEED)\n",
    "\n",
    "cv_search_results = []\n",
    "\n",
    "print(\"Randomized Search with 5-Fold Cross-Validation (No Leakage)\\n\")\n",
    "print(f\"Testing {n_iter} random parameter combinations\\n\")\n",
    "\n",
    "# --- Loop through sampled parameter combinations ---\n",
    "for i, params in enumerate(param_samples, start=1):\n",
    "    fold_scores = []\n",
    "\n",
    "    print(f\"► Combination {i}/{n_iter}: {params}\")\n",
    "\n",
    "    # Cross-validation loop\n",
    "    for fold, (train_idx, val_idx) in enumerate(kf_search.split(X_train_val, y_train_val), start=1):\n",
    "        X_fold_train = X_train_val.iloc[train_idx]\n",
    "        y_fold_train = y_train_val.iloc[train_idx]\n",
    "        X_fold_val = X_train_val.iloc[val_idx]\n",
    "        y_fold_val = y_train_val.iloc[val_idx]\n",
    "\n",
    "        # --- Define model for this fold ---\n",
    "        model = RandomForestRegressor(random_state=RANDOM_SEED, n_jobs=-1, **params)\n",
    "\n",
    "        # --- Train with preprocessing (your function) ---\n",
    "        trained_model, fitted_scaler, fill_values = run_model(\n",
    "            X_fold_train, y_fold_train,\n",
    "            int_cols=int_cols,\n",
    "            float_cols=float_cols,\n",
    "            model=model,\n",
    "            scaler=None   # no scaling needed for trees\n",
    "        )\n",
    "\n",
    "        # --- Evaluate on validation fold (no leakage) ---\n",
    "        fold_score = evaluate_model(\n",
    "            X_fold_val, y_fold_val,\n",
    "            trained_model,\n",
    "            int_cols=int_cols,\n",
    "            float_cols=float_cols,\n",
    "            fill_values=fill_values,\n",
    "            scaler=fitted_scaler\n",
    "        )\n",
    "\n",
    "        fold_scores.append(fold_score)\n",
    "        print(f\"   Fold {fold}: R² = {fold_score:.4f}\")\n",
    "\n",
    "    # --- Average CV score for this parameter combination ---\n",
    "    mean_cv_score = np.mean(fold_scores)\n",
    "    std_cv_score = np.std(fold_scores)\n",
    "\n",
    "    cv_search_results.append({\n",
    "        **params,\n",
    "        \"mean_score\": mean_cv_score,\n",
    "        \"std_score\": std_cv_score\n",
    "    })\n",
    "\n",
    "    print(f\"→ Mean CV R²: {mean_cv_score:.4f} (+/- {std_cv_score:.4f})\\n\")\n",
    "\n",
    "# --- Find best parameters ---\n",
    "best_result = max(cv_search_results, key=lambda x: x[\"mean_score\"])\n",
    "\n",
    "print(\"Best Parameters:\")\n",
    "for k, v in best_result.items():\n",
    "    if k not in [\"mean_score\", \"std_score\"]:\n",
    "        print(f\"  {k}: {v}\")\n",
    "\n",
    "print(f\"\\nBest CV R²: {best_result['mean_score']:.4f} (+/- {best_result['std_score']:.4f})\")"
   ]
  },
